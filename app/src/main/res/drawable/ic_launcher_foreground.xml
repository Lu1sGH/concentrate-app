<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Segmented Focus Ring (Top-Left & Bottom-Right Arcs) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M34.2,34.2 A28,28 0 0,1 73.8,34.2 M73.8,73.8 A28,28 0 0,1 34.2,73.8"
        android:strokeWidth="2.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82"
                android:endY="82"
                android:startX="26"
                android:startY="26"
                android:type="linear">
                <item
                    android:color="#00F0FF"
                    android:offset="0.0" />
                <item
                    android:color="#7C4DFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary Lateral Focus Arcs -->
    <path
        android:fillColor="#00000000"
        android:pathData="M29.8,40 A28,28 0 0,0 29.8,68 M78.2,40 A28,28 0 0,1 78.2,68"
        android:strokeWidth="1.4"
        android:strokeColor="#6600F0FF"
        android:strokeLineCap="round" />

    <!-- Rotated Geometric Focus Prism (Diamond Shield) -->
    <path
        android:fillColor="#1A00F0FF"
        android:pathData="M54,32 L76,54 L54,76 L32,54 Z"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="76"
                android:endY="76"
                android:startX="32"
                android:startY="32"
                android:type="linear">
                <item
                    android:color="#00F0FF"
                    android:offset="0.0" />
                <item
                    android:color="#38B6FF"
                    android:offset="0.5" />
                <item
                    android:color="#9D6BFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cardinal Convergence Vectors (Pointing Inward to the Core) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,23 L54,29 M54,85 L54,79 M23,54 L29,54 M85,54 L79,54"
        android:strokeWidth="2.2"
        android:strokeColor="#00F0FF"
        android:strokeLineCap="round" />

    <!-- Inner Precision Ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0"
        android:strokeWidth="1.5"
        android:strokeColor="#AAFFFFFF" />

    <!-- Central Concentrate Diamond Core -->
    <path android:pathData="M54,46.5 L61.5,54 L54,61.5 L46.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="61.5"
                android:endY="61.5"
                android:startX="46.5"
                android:startY="46.5"
                android:type="linear">
                <item
                    android:color="#FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#80F8FF"
                    android:offset="0.5" />
                <item
                    android:color="#00E5FF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bright Singularity Point -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-2.2,0a2.2,2.2 0,1 1,4.4 0a2.2,2.2 0,1 1,-4.4 0" />
</vector>
